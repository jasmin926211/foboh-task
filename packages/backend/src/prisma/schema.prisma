generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdjustmentType {
  fixed
  dynamic
  custom
}

enum AdjustmentDirection {
  increase
  decrease
}

enum ProfileStatus {
  draft
  published
}

enum ProfileScope {
  all
  selected
}

model Product {
  id          String   @id @default(uuid())
  title       String
  sku         String   @unique
  category    String   @default("Wine")
  subCategory String   @map("sub_category")
  segment     String
  brand       String
  basePrice   Float    @map("base_price")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profileProducts ProfileProduct[]

  @@map("products")
}

model Customer {
  id        String   @id @default(uuid())
  name      String   @unique
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships     CustomerGroupMembership[]
  pricingProfiles PricingProfile[]

  @@map("customers")
}

model CustomerGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships     CustomerGroupMembership[]
  pricingProfiles PricingProfile[]

  @@map("customer_groups")
}

model CustomerGroupMembership {
  id              String @id @default(uuid())
  customerId      String @map("customer_id")
  customerGroupId String @map("customer_group_id")

  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerGroup CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)

  @@unique([customerId, customerGroupId])
  @@map("customer_group_memberships")
}

model PricingProfile {
  id                  String              @id @default(uuid())
  name                String
  customerId          String?             @map("customer_id")
  customerGroupId     String?             @map("customer_group_id")
  adjustmentType      AdjustmentType      @map("adjustment_type")
  adjustmentDirection AdjustmentDirection? @map("adjustment_direction")
  adjustmentValue     Float?              @map("adjustment_value")
  status              ProfileStatus       @default(draft)
  scope               ProfileScope        @default(selected)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  customer        Customer?       @relation(fields: [customerId], references: [id])
  customerGroup   CustomerGroup?  @relation(fields: [customerGroupId], references: [id])
  profileProducts ProfileProduct[]

  @@map("pricing_profiles")
}

model ProfileProduct {
  id          String         @id @default(uuid())
  profileId   String         @map("profile_id")
  productId   String         @map("product_id")
  customPrice Float?         @map("custom_price")

  profile   PricingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([profileId, productId])
  @@map("profile_products")
}
